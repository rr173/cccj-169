#!/usr/bin/env python3
"""Thin launcher for the independent SQLite landing end.

Kept separate from ``mdm`` so the reference consumer is visibly its own
program/database; works under ``python -I`` without installation.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from mdm_merge.cli import main  # noqa: E402

if __name__ == "__main__":
    # Only landing-* subcommands make sense here; unknown commands still
    # produce the normal argparse error, while source-side commands work too
    # since both ends share one entry module.
    raise SystemExit(main())
